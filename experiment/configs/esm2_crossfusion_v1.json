{
  "experiment_name": "esm2_crossfusion_v1",
  "data_dir": "replication/MMUbiPred",
  "output_dir": "experiment/outputs/esm2_crossfusion_v1_seed42",
  "seed": 42,
  "window_size": 49,
  "validation_fraction": 0.1,
  "split_strategy": "protein_grouped",
  "batch_size": 128,
  "num_workers": 2,
  "epochs": 20,
  "early_stopping_patience": 5,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "optimizer": "adamw",
  "optimizer_epsilon": 1e-8,
  "gradient_clip_norm": 1.0,
  "use_amp": true,
  "model": {
    "architecture": "esm2_crossfusion_v1",
    "pretrained_model_name": "facebook/esm2_t6_8M_UR50D",
    "freeze_backbone": true,
    "unfreeze_last_n_layers": 0,
    "branch_dim": 128,
    "conv_channels": 32,
    "conv_kernels": [3, 5, 7],
    "conv_dilations": [1, 2, 3],
    "dropout": 0.25
  }
}
